import React, { useState, useEffect } from 'react';
import { View, Text, TouchableOpacity, ScrollView, Alert, StyleSheet } from 'react-native';
import * as Notifications from 'expo-notifications';
import AsyncStorage from '@react-native-async-storage/async-storage';

// إعداد الإشعارات
Notifications.setNotificationHandler({
  handleNotification: async () => ({
    shouldShowAlert: true,
    shouldPlaySound: true,
    shouldSetBadge: false,
  }),
});

async function registerForPushNotificationsAsync() {
  const { status } = await Notifications.requestPermissionsAsync();
  if (status !== 'granted') {
    Alert.alert('الإشعارات غير مفعلة', 'يجب السماح بالإشعارات لاستقبال التنبيهات');
    return;
  }
  const token = (await Notifications.getExpoPushTokenAsync()).data;
  await AsyncStorage.setItem('pushToken', token);
  console.log('Expo Push Token:', token);
}

const ApprovalManager = {
  async updateApprovalStatus(requestId, role, status, comment) {
    const approvals = await AsyncStorage.getItem('approvals');
    let approvalsList = approvals ? JSON.parse(approvals) : [];
    const requestIndex = approvalsList.findIndex(req => req.id === requestId);
    
    if (requestIndex >= 0) {
      const request = approvalsList[requestIndex];
      request.status = status;
      request.comment = comment;
      approvalsList[requestIndex] = request;
      await AsyncStorage.setItem('approvals', JSON.stringify(approvalsList));
      sendNotification(status);
    }
  }
};

async function sendNotification(status) {
  const token = await AsyncStorage.getItem('pushToken');
  if (!token) return;
  await Notifications.scheduleNotificationAsync({
    content: {
      title: 'تحديث الموافقة',
      body: `تم ${status === 'approved' ? 'الموافقة' : 'الرفض'} على المستند!`,
    },
    trigger: null,
  });
}

const ApprovalManagement = () => {
  const [approvals, setApprovals] = useState([]);
  const [currentUserRole] = useState('store_keeper');

  useEffect(() => {
    registerForPushNotificationsAsync();
    loadApprovals();
  }, []);

  const loadApprovals = async () => {
    const loadedApprovals = await AsyncStorage.getItem('approvals');
    setApprovals(loadedApprovals ? JSON.parse(loadedApprovals) : []);
  };

  const handleApproval = async (requestId, status) => {
    await ApprovalManager.updateApprovalStatus(requestId, currentUserRole, status, '');
    loadApprovals();
  };

  return (
    <View style={styles.container}>
      <Text style={styles.title}>الموافقات</Text>
      <ScrollView>
        {approvals.map((request, index) => (
          <View key={index} style={styles.approvalItem}>
            <Text>{request.title}</Text>
            <Text>{request.status}</Text>
            <TouchableOpacity onPress={() => handleApproval(request.id, 'approved')}>
              <Text>موافقة ✅</Text>
            </TouchableOpacity>
            <TouchableOpacity onPress={() => handleApproval(request.id, 'rejected')}>
              <Text>رفض ❌</Text>
            </TouchableOpacity>
          </View>
        ))}
      </ScrollView>
    </View>
  );
};

const styles = StyleSheet.create({
  container: { padding: 20 },
  title: { fontSize: 20, fontWeight: 'bold', marginBottom: 10 },
  approvalItem: { padding: 10, backgroundColor: '#f9f9f9', marginBottom: 10, borderRadius: 5 },
});

export default ApprovalManagement;
